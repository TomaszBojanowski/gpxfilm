#. texts of argparse, the module that reads the options
#: gpxfilm/cli.py
msgid "usage: "
msgstr "użycie: "

#: gpxfilm/cli.py
msgid "positional arguments"
msgstr "argumenty pozycyjne"

#: gpxfilm/cli.py
msgid "options"
msgstr "opcje"

#: gpxfilm/cli.py
msgid "show this help message and exit"
msgstr "pokaż tę pomoc i zakończ"

#: gpxfilm/cli.py
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s: błąd: %(message)s\n"

#: gpxfilm/cli.py
msgid "unrecognized arguments: %s"
msgstr "nierozpoznane argumenty: %s"

#. after "argument --fps:"
#: gpxfilm/cli.py
msgid "expected one argument"
msgstr "oczekiwano jednego argumentu"

#. %(type)s is a name from the code, such as int or float
#: gpxfilm/cli.py
msgid "invalid %(type)s value: %(value)r"
msgstr "nieprawidłowa wartość typu %(type)s: %(value)r"

#: gpxfilm/cli.py
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "nieprawidłowy wybór: %(value)r (do wyboru: %(choices)s)"

#: gpxfilm/cli.py
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "niejednoznaczna opcja: %(option)s może oznaczać %(matches)s"

#. a value given to an option that takes none, as in --gui=yes
#: gpxfilm/cli.py
msgid "ignored explicit argument %r"
msgstr "pominięto podaną wartość %r"

#: gpxfilm/cli.py
msgid "A film of a GPX route on a shaded terrain map."
msgstr "Film z trasy GPX na cieniowanej mapie terenu."

#: gpxfilm/cli.py
msgid "GPX file with the track"
msgstr "plik GPX ze śladem"

#: gpxfilm/cli.py
msgid "open the settings window in the browser (preview and render the film without typing options)"
msgstr "otwórz okno ustawień w przeglądarce (podgląd i generowanie filmu bez wpisywania opcji)"

#: gpxfilm/cli.py
msgid "check which sources of aerial photos (--map aerial) answer right now, and exit"
msgstr "sprawdź, które źródła zdjęć lotniczych (--map aerial) teraz odpowiadają, i zakończ"

#: gpxfilm/cli.py
msgid "port of the settings window (default: any free one)"
msgstr "port okna ustawień (domyślnie dowolny wolny)"

#: gpxfilm/cli.py
msgid "output MP4 file (default: the name of the GPX file with the .mp4 extension)"
msgstr "plik wynikowy MP4 (domyślnie: nazwa pliku GPX z rozszerzeniem .mp4)"

#: gpxfilm/cli.py
msgid "title; separate its lines with \"\\n\" (default: the track name from the file)"
msgstr "tytuł; kolejne wiersze oddziel przez \"\\n\" (domyślnie: nazwa śladu z pliku)"

#: gpxfilm/cli.py
msgid "line under the title (default: the date of the track)"
msgstr "wiersz pod tytułem (domyślnie: data ze śladu)"

#: gpxfilm/cli.py
msgid "16:9 frame size, e.g. 3840x2160 or 1920x1080"
msgstr "rozmiar kadru 16:9, np. 3840x2160 albo 1920x1080"

#: gpxfilm/cli.py
msgid "frames per second"
msgstr "liczba klatek na sekundę"

#: gpxfilm/cli.py
msgid "seconds the route takes to draw"
msgstr "ile sekund trwa rysowanie trasy"

#: gpxfilm/cli.py
msgid "route color, e.g. #E5202E"
msgstr "kolor trasy, np. #E5202E"

#: gpxfilm/cli.py
msgid "maximum number of labeled places along the route"
msgstr "największa liczba podpisanych miejsc przy trasie"

#: gpxfilm/cli.py
msgid "maximum number of labeled peaks off the route"
msgstr "największa liczba podpisanych szczytów poza trasą"

#: gpxfilm/cli.py
msgid "how many of the highest peaks the intro shows, over the region and after the camera arrives (0 = none)"
msgstr "ile najwyższych szczytów pokazać w intrze, nad okolicą i po dojeździe kamery (0 = wcale)"

#: gpxfilm/cli.py
msgid "how many of the main places (cities, towns, villages) of the region the intro shows (0 = none)"
msgstr "ile najważniejszych miejscowości okolicy (miast, miasteczek, wsi) pokazać w intrze (0 = wcale)"

#: gpxfilm/cli.py
msgid "radius around the start within which the intro looks for the highest peaks and the main places"
msgstr "promień od startu, w którym intro szuka najwyższych szczytów i najważniejszych miejscowości"

#: gpxfilm/cli.py
msgid "seconds the labels of the places and peaks of the intro stay fully visible, from the last one coming in until they start to fade, both during the pause over the region and after the camera arrives (0.5 to 20; without it about 1.3 s over the region and 0.8 s after the camera arrives)"
msgstr "ile sekund podpisy miejscowości i szczytów w intrze są w pełni widoczne, od pojawienia się ostatniego do początku gaśnięcia, przy postoju nad okolicą i po dojeździe (od 0.5 do 20; bez opcji ok. 1.3 s nad okolicą i 0.8 s po dojeździe)"

#: gpxfilm/cli.py
msgid "language of the texts on the film"
msgstr "język napisów"

#: gpxfilm/cli.py
msgid "labels on the map: plain, strong (thick dark outline) or badges (dark background behind the text)"
msgstr "podpisy na mapie: plain (zwykłe), strong (gruby ciemny obrys) albo badges (ciemne tło pod napisem)"

#: gpxfilm/cli.py
msgid "scale of the labels on the map, from 0.7 to 2.0, e.g. 1.25"
msgstr "powiększenie podpisów na mapie, od 0.7 do 2.0, np. 1.25"

#: gpxfilm/cli.py
msgid "preferred language of the names from OpenStreetMap, e.g. it or de,it"
msgstr "preferowany język nazw z OpenStreetMap, np. it albo de,it"

#: gpxfilm/cli.py
msgid "rename a place on the film (can be given more than once)"
msgstr "zmień nazwę miejsca na filmie (można podać wiele razy)"

#: gpxfilm/cli.py
msgid "do not label places whose name contains this text (can be given more than once)"
msgstr "nie podpisuj miejsc, których nazwa zawiera ten tekst (można podać wiele razy)"

#: gpxfilm/cli.py
msgid "time zone of the clock times on the film, e.g. Europe/Rome (default: the system time zone)"
msgstr "strefa czasowa godzin na filmie, np. Europe/Rome (domyślnie: systemowa)"

#: gpxfilm/cli.py
msgid "start with a view of the whole country and fly the camera to the region of the route"
msgstr "zacznij od widoku całego kraju i dojedź kamerą do okolicy trasy"

#: gpxfilm/cli.py
msgid "seconds the camera flight takes"
msgstr "ile sekund trwa dojazd kamery"

#: gpxfilm/cli.py
msgid "folder with photos: each one appears at the place where it was taken (by the time stored in the file)"
msgstr "katalog ze zdjęciami: każde pokaże się w miejscu, w którym zostało zrobione (według godziny zapisanej w pliku)"

#: gpxfilm/cli.py
msgid "seconds each photo is shown"
msgstr "ile sekund widać każde zdjęcie"

#: gpxfilm/cli.py
msgid "correction of the camera clock in seconds (positive when the camera was behind)"
msgstr "poprawka zegara aparatu w sekundach (dodatnia, gdy aparat się spóźniał)"

#: gpxfilm/cli.py
msgid "maximum number of photos on the film (0 = all)"
msgstr "największa liczba zdjęć na filmie (0 = wszystkie)"

#: gpxfilm/cli.py
msgid "pause at stops of at least this many minutes (0 = off)"
msgstr "zatrzymaj się na postojach trwających co najmniej tyle minut (0 = wyłącz)"

#: gpxfilm/cli.py
msgid "your own labels, one per line: \"46.6187, 12.3085 Name\", \"3.2 km Name\" or \"12:39 Name\""
msgstr "własne podpisy, po jednym w wierszu: \"46.6187, 12.3085 Nazwa\", \"3,2 km Nazwa\" albo \"12:39 Nazwa\""

#: gpxfilm/cli.py
msgid "kilometer markers along the route"
msgstr "znaczniki kolejnych kilometrów na trasie"

#: gpxfilm/cli.py
msgid "distance from your watch in km: the film ends on this value (rounded to 0.1 km, like every distance on the film), and the counters and kilometer markers follow it (without this option the distance worked out from the track usually differs from the watch by about ±2%%)"
msgstr "dystans z zegarka w km: film skończy się na tej wartości (zaokrąglonej do 0,1 km, jak każdy dystans na filmie), a liczniki i znaczniki kilometrów dopasują się do niej (bez tej opcji dystans liczony ze śladu różni się zwykle od zegarka o ok. ±2%%)"

#: gpxfilm/cli.py
msgid "total ascent from your watch in m: the film ends on this value"
msgstr "suma podejść z zegarka w m: film skończy się na tej wartości"

#: gpxfilm/cli.py
msgid "extra live counters: time of day, elevation, speed and heart rate"
msgstr "dodatkowe liczniki na żywo: godzina, wysokość, prędkość i tętno"

#: gpxfilm/cli.py
msgid "leave out the heart rate, even if the file has it"
msgstr "pomiń tętno, nawet jeśli jest w pliku"

#: gpxfilm/cli.py
msgid "color the route by data from the track"
msgstr "kolor trasy zależny od danych ze śladu"

#: gpxfilm/cli.py
msgid "your own typeface for the title and the numbers"
msgstr "własny krój pisma tytułu i liczb"

#: gpxfilm/cli.py
msgid "logo in the top right corner of the frame"
msgstr "znak w prawym górnym rogu kadru"

#: gpxfilm/cli.py
msgid "end with a summary card"
msgstr "zakończ planszą z podsumowaniem"

#: gpxfilm/cli.py
msgid "seconds the summary card lasts"
msgstr "ile sekund trwa plansza końcowa"

#: gpxfilm/cli.py
msgid "background music (looped and faded out at the end)"
msgstr "podkład dźwiękowy (zapętlany i wyciszany na końcu)"

#: gpxfilm/cli.py
msgid "quick draft: 1280x720 at 30 fps"
msgstr "szybka wersja próbna: 1280x720 i 30 kl./s"

#: gpxfilm/cli.py
msgid "save images for slides: the map alone, a frame at each labeled place and the final frame"
msgstr "zapisz obrazy na slajdy: samą mapę, kadr przy każdym podpisanym miejscu i kadr końcowy"

#: gpxfilm/cli.py
msgid "map background: terrain (the default, shaded relief), topo (OpenTopoMap), aerial (official aerial photos of the route's country, very sharp), satellite (Sentinel-2, whole world, 10 m) or your own tile address with {z}/{x}/{y} or a WMS address with {bbox}"
msgstr "podkład: terrain (domyślny, cieniowana rzeźba), topo (OpenTopoMap), aerial (urzędowe zdjęcia lotnicze kraju trasy, bardzo ostre), satellite (Sentinel-2, cały świat, 10 m) albo własny adres kafli z {z}/{x}/{y} lub adres WMS z {bbox}"

#: gpxfilm/cli.py
msgid "color style of the map"
msgstr "styl barw mapy"

#: gpxfilm/cli.py
msgid "light the map from the direction of the sun halfway along the route"
msgstr "oświetl mapę z kierunku, z którego świeciło słońce w połowie trasy"

#: gpxfilm/cli.py
msgid "small outline of the country with a marker of the place in a corner of the map"
msgstr "mały zarys kraju ze znacznikiem miejsca w rogu mapy"

#: gpxfilm/cli.py
msgid "label lakes and towns in the background of the map"
msgstr "podpisz na mapie jeziora i miejscowości w tle"

#: gpxfilm/cli.py
msgid "when no title is given, take the name of the town and region from the map"
msgstr "gdy nie podano tytułu, weź nazwę miejscowości i regionu z mapy"

#: gpxfilm/cli.py
msgid "save a description of the film: labeled places, matched photos, expected length"
msgstr "zapisz opis filmu: podpisane miejsca, dopasowane zdjęcia, przewidywaną długość"

#: gpxfilm/cli.py
msgid "also save the last frame as PNG"
msgstr "zapisz dodatkowo ostatnią klatkę jako PNG"

#: gpxfilm/cli.py
msgid "save only the last frame, no film"
msgstr "zapisz tylko ostatnią klatkę, bez filmu"

#: gpxfilm/cli.py
msgid "do not download OpenStreetMap data"
msgstr "nie pobieraj danych OpenStreetMap"

#: gpxfilm/cli.py
msgid "draw only the track or route with this number when the file has several (the number from the list the program prints)"
msgstr "narysuj tylko ślad albo trasę o tym numerze, gdy w pliku jest ich kilka (numer z listy, którą program wypisuje)"

#: gpxfilm/cli.py
msgid "use the times from the GPX file even if they look fake (e.g. a planned route with times from 1970 or a ride faster than 400 km/h)"
msgstr "użyj godzin z pliku GPX, nawet jeśli wyglądają na udawane (np. trasa zaplanowana z godzinami od 1970 roku albo przejazd szybszy niż 400 km/h)"

#: gpxfilm/cli.py
msgid "encoding quality (lower = better, larger file)"
msgstr "jakość kodowania (mniej = lepiej, większy plik)"

#: gpxfilm/cli.py
msgid "force an ffmpeg encoder, e.g. libx264"
msgstr "wymuś koder ffmpeg, np. libx264"

#: gpxfilm/cli.py
msgid "The settings file {file} uses old names. They work, but replace them with the new ones:\n{changes}\nThis notice appears again only after the file changes."
msgstr "Plik ustawień {file} używa starych nazw. Działają, ale zamień je na nowe:\n{changes}\nTa informacja pojawi się znowu dopiero po zmianie pliku."

#: gpxfilm/cli.py
msgid "Unknown settings in {file}: {names}"
msgstr "Nieznane ustawienia w {file}: {names}"

#: gpxfilm/cli.py
msgid "The settings file needs Python 3.11 or newer – skipping it."
msgstr "Plik ustawień wymaga Pythona 3.11 lub nowszego – pomijam go."

#: gpxfilm/cli.py
msgid "--distance must be a number greater than zero (in km, at most 100000)"
msgstr "--distance musi być liczbą większą od zera (w km, najwyżej 100000)"

#: gpxfilm/cli.py
msgid "--ascent must be a non-negative number (in m, at most 1000000)"
msgstr "--ascent musi być liczbą nieujemną (w m, najwyżej 1000000)"

#: gpxfilm/cli.py
msgid "--intro-peaks must be a non-negative number"
msgstr "--intro-peaks musi być liczbą nieujemną"

#: gpxfilm/cli.py
msgid "--intro-places must be a non-negative number"
msgstr "--intro-places musi być liczbą nieujemną"

#: gpxfilm/cli.py
msgid "--intro-radius must be a number greater than zero (in km, at most 100)"
msgstr "--intro-radius musi być liczbą większą od zera (w km, najwyżej 100)"

#: gpxfilm/cli.py
msgid "--intro-label-duration must be a number from 0.5 to 20 (in seconds)"
msgstr "--intro-label-duration musi być liczbą od 0.5 do 20 (w sekundach)"

#: gpxfilm/cli.py
msgid "--label-size must be a number from 0.7 to 2.0"
msgstr "--label-size musi być liczbą od 0.7 do 2.0"

#: gpxfilm/cli.py
msgid "give a GPX file or run with the --gui option"
msgstr "podaj plik GPX albo uruchom z opcją --gui"

#: gpxfilm/cli.py
msgid "The frame must have a 16:9 aspect ratio."
msgstr "Kadr musi mieć proporcje 16:9."

#: gpxfilm/cli.py
msgid "Unknown map background. Choose terrain, topo, aerial, satellite or a tile address with {z}, {x} and {y}."
msgstr "Nieznany podkład. Do wyboru: terrain, topo, aerial, satellite albo adres kafli zawierający {z}, {x} i {y}."

#: gpxfilm/cli.py
msgid "label line not understood: {line}"
msgstr "nie rozumiem wiersza podpisów: {line}"

#: gpxfilm/cli.py
msgid "No open aerial photos are known for this country ({country}) – using Sentinel-2 satellite imagery."
msgstr "Nie znam otwartej ortofotomapy dla tego kraju ({country}) – biorę zdjęcia satelitarne Sentinel-2."

#: gpxfilm/cli.py
msgid "it could not be determined"
msgstr "nie udało się go ustalić"

#: gpxfilm/cli.py
msgid "Map: user-supplied background. Terrain: Mapterhorn"
msgstr "Mapa: podkład użytkownika. Teren: Mapterhorn"

#: gpxfilm/cli.py
msgid "Sun halfway along the route: azimuth {azimuth}°, altitude {altitude}°"
msgstr "Słońce w połowie trasy: azymut {azimuth}°, wysokość {altitude}°"

#: gpxfilm/cli.py
msgid "Could not get the place name: {error}"
msgstr "Nie udało się pobrać nazwy miejsca: {error}"

#: gpxfilm/cli.py
msgid "Drawing the background…"
msgstr "Rysuję tło…"

#: gpxfilm/cli.py
msgid "Saved images for slides: {folder} ({n} file)"
msgid_plural "Saved images for slides: {folder} ({n} files)"
msgstr[0] "Zapisano kadry na slajdy: {folder} ({n} plik)"
msgstr[1] "Zapisano kadry na slajdy: {folder} ({n} pliki)"
msgstr[2] "Zapisano kadry na slajdy: {folder} ({n} plików)"

#: gpxfilm/cli.py
msgid "Intro: could not plan the camera flight ({error}) – the film length in the report is approximate."
msgstr "Intro: nie udało się zaplanować przelotu ({error}) – czas filmu w raporcie jest przybliżony."

#: gpxfilm/cli.py
msgid "Saved the frame: {file}"
msgstr "Zapisano kadr: {file}"

#: gpxfilm/cli.py
msgctxt "slide file name"
msgid "map"
msgstr "mapa"

#: gpxfilm/cli.py
msgctxt "slide file name"
msgid "finish"
msgstr "meta"

#: gpxfilm/compose.py
msgid "No data to color the route by ({mode}) – keeping one color."
msgstr "Brak danych do kolorowania trasy ({mode}) – zostaje jeden kolor."

#: gpxfilm/compose.py
msgid "Could not prepare the minimap: {error}"
msgstr "Nie udało się przygotować minimapy: {error}"

#: gpxfilm/compose.py
msgid "skipping {name}: neither the time nor the position of the photo matches the route"
msgstr "pomijam {name}: godzina ani pozycja zdjęcia nie pasują do trasy"

#: gpxfilm/compose.py
msgid "Photos on the route: {n} of {total}"
msgstr "Zdjęcia na trasie: {n} z {total}"

#: gpxfilm/terrain.py
msgid "Could not download the terrain model for the elevation profile – keeping the elevation from the file."
msgstr "Nie udało się pobrać modelu terenu do profilu wysokości – zostaje wysokość z pliku."

#: gpxfilm/terrain.py
msgid "Could not download the terrain model for the elevation profile – using the elevation from the frame's map."
msgstr "Nie udało się pobrać modelu terenu do profilu wysokości – wysokość z mapy kadru."

#: gpxfilm/terrain.py
msgid "The elevation in the file is very noisy (total ascent {ascent} m, {model} m by the terrain model) – taking it from the terrain model."
msgstr "Wysokość z pliku mocno szumi (suma podejść {ascent} m, według modelu terenu {model} m) – biorę ją z modelu terenu."

#: gpxfilm/terrain.py
msgid "Terrain model: {n} tile, zoom {zoom}"
msgid_plural "Terrain model: {n} tiles, zoom {zoom}"
msgstr[0] "Model terenu: {n} kafel, poziom {zoom}"
msgstr[1] "Model terenu: {n} kafle, poziom {zoom}"
msgstr[2] "Model terenu: {n} kafli, poziom {zoom}"

#: gpxfilm/terrain.py
msgid "Aerial photos do not cover this place – using Sentinel-2 satellite imagery."
msgstr "Zdjęcia lotnicze nie obejmują tego miejsca – biorę satelitarne Sentinel-2."

#: gpxfilm/terrain.py
msgid "Aerial photos: {error} – using Sentinel-2 satellite imagery for the whole frame."
msgstr "Zdjęcia lotnicze: {error} – biorę dla całego kadru zdjęcia satelitarne Sentinel-2."

#: gpxfilm/terrain.py
msgid "Map background: {error}."
msgstr "Podkład mapy: {error}."

#: gpxfilm/terrain.py
msgid "Could not download the map background – keeping the terrain map."
msgstr "Podkładu nie udało się pobrać – zostaje mapa terenu."

#: gpxfilm/film.py
msgid "level {level}/{total}"
msgstr "poziom {level}/{total}"

#: gpxfilm/film.py
msgid "level {level}/{total}: country view ({country})"
msgstr "poziom {level}/{total}: widok kraju ({country})"

#: gpxfilm/film.py
msgid "level {level}/{total}: country view"
msgstr "poziom {level}/{total}: widok kraju"

#: gpxfilm/film.py
msgid "Place in the intro: the most important one within {radius} km of the start"
msgid_plural "Places in the intro: the {n} most important within {radius} km of the start"
msgstr[0] "Miejscowość w intrze: najważniejsza w promieniu {radius} km od startu"
msgstr[1] "Miejscowości w intrze: {n} najważniejsze w promieniu {radius} km od startu"
